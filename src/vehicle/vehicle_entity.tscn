[gd_scene load_steps=3 format=3 uid="uid://vehicle_entity"]

[ext_resource type="Script" path="res://src/driving/vehicle_controller.gd" id="script_vehicle_controller"]
[ext_resource type="Script" path="res://src/core/vehicle_attribute.gd" id="script_vehicle_attribute"]

[node name="VehicleEntity" type="Node2D"]
# VehicleEntity — 战车实体根节点
# 包含控制器、属性、视觉和摄像机

[node name="VehicleController" type="Node2D" parent="."]
script = ExtResource("script_vehicle_controller")
vehicle_id = 1

[node name="Polygon2D" type="Polygon2D" parent="VehicleController"]
# 占位符：战车主体视觉（64x64像素蓝色方块）
color = Color(0.3, 0.5, 0.8, 1)
polygon = PackedVector2Array(0, 0, 64, 0, 64, 64, 0, 64)
offset = Vector2(-32, -32)

[node name="VehicleAttribute" type="Node" parent="VehicleController"]
script = ExtResource("script_vehicle_attribute")

[node name="Camera2D" type="Camera2D" parent="."]
# 摄像机跟随战车
zoom = Vector2(1, 1)
position_smoothing_enabled = true
position_smoothing_speed = 10.0