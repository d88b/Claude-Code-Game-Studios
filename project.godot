; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="铁锈魔潮"
config/name_localized={
"en": "Rust Magic Tide",
"zh": "铁锈魔潮"
}
config/description="末世战车生存游戏 — 探索、挖掘、建造、防守"
run/main_scene="res://src/app_root.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
config/version="0.1.0-alpha"

[autoload]

GlobalSignals="*res://src/events/global_signals.gd"
LocalizationManager="*res://src/core/localization_manager.gd"
VersionManager="*res://src/core/version_manager.gd"
BlockTypeDB="*res://src/database/block_type_db.gd"
ResourceDB="*res://src/database/resource_db.gd"
EnemyTypeDB="*res://src/database/enemy_type_db.gd"
VehicleTypeDB="*res://src/database/vehicle_type_db.gd"
BuildItemDB="*res://src/database/build_item_db.gd"
TimeSystem="*res://src/time/time_system.gd"
InputManager="*res://src/input/input_manager.gd"
CollisionManager="*res://src/collision/collision_manager.gd"
FacilityController="*res://src/facility/facility_controller.gd"
SaveManager="*res://src/save/save_manager.gd"
	AmbientAudioManager="*res://src/audio/ambient_audio_manager.gd"
AudioManager="*res://src/audio/audio_manager.gd"
AnalyticsManager="*res://src/analytics/analytics_manager.gd"
AchievementManager="*res://src/achievement/achievement_manager.gd"
CrashManager="*res://src/crash/crash_manager.gd"
SteamManager="*res://src/platform/steam_manager.gd"
TutorialManager="*res://src/ui/tutorial_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor]

naming/script_name_casing=3

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

